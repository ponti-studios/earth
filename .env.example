# Local dev (earth-db container):
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/earth"
# Production (Railway): set DATABASE_URL from the Postgres plugin
# (e.g. reference ${{Postgres.DATABASE_URL}}) and PORT is injected.
# Optional: TfL API credentials raise anonymous rate limits.
# TFL_APP_ID=""
# TFL_APP_KEY=""
# PORT="3000"
